{
  "name": "keycat-overlay",
  "productName": "KeyCat",
  "version": "1.0.1",
  "description": "BongoCat 风格的键鼠 / 手柄输入显示，内置 input-overlay 5.0.5 全部预设，支持在桌面上同时摆放多个预设",
  "main": "src/main/main.js",
  "private": true,
  "author": "KeyCat",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check-presets.js",
    "preview": "node scripts/render-preview.mjs",
    "dist": "electron-builder --win --x64 --dir",
    "dist:setup": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "pngjs": "7.0.0"
  },
  "build": {
    "appId": "com.keycat.overlay",
    "productName": "KeyCat",
    "asar": true,
    "files": [
      "src/**/*",
      "presets/**/*",
      "assets/**/*",
      "preset-meta.json",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KeyCat",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "KeyCat-Setup-${version}.exe"
    }
  }
}
